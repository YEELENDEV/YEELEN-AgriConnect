# ─────────────────────────────────────────────────────────────────────
# Variables lues par le backend (server/). Copier en `server/.env` et remplir.
# `server/.env` est gitignoré — ne jamais le committer.
# ─────────────────────────────────────────────────────────────────────

# --- Connexion PostgreSQL ---
# En Docker, DB_HOST=db (nom du service Compose) et DB_PORT=5432 (port interne
# du conteneur — indépendant du remap hôte 5433 de docker-compose.yml).
DB_HOST=db
DB_PORT=5432
DB_USER=agri
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
DB_NAME=agri_app

# --- Serveur HTTP ---
PORT=4000

# --- Signature des JWT ---
# DOIT être une chaîne aléatoire d'au moins 32 caractères : avec NODE_ENV=production, le
# backend REFUSE DE DÉMARRER si elle est absente ou plus courte.
# Générer p. ex. avec :  openssl rand -base64 48
JWT_SECRET=
# Durée de validité d'une session (format jsonwebtoken : 7d, 12h…). Défaut : 7d.
# JWT_EXPIRES_IN=7d

# --- Sécurité HTTP (optionnel) ---
# NODE_ENV=production active les contrôles de production (posé par docker-compose.prod.yml).
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules. Par
# défaut : FRONTEND_URL, la même origine, et (hors production) tout localhost.
# CORS_ORIGINS=https://app.exemple.com
# URL publique du frontend (liens de devis envoyés par email/WhatsApp).
# FRONTEND_URL=https://app.exemple.com
# Proxys autorisés à fournir X-Forwarded-For (réglage Express `trust proxy`). Défaut :
# loopback + réseaux privés (le réseau Docker où tourne Caddy).
# TRUST_PROXY=loopback, linklocal, uniquelocalCHANGEZ_MOI_secret_aleatoire_long

# --- E-mail (optionnel) ---
# Sans ces valeurs, les fonctions e-mail échouent proprement : code MFA par
# e-mail, e-mail de bienvenue employé, envoi de devis au client.
# Identifiants Gmail (mot de passe d'application, pas le mot de passe du compte).
EMAIL_USER=
EMAIL_PASS=

# --- Abonnement Phase 1 : essai + activation manuelle (optionnel) ---
# Durée de la période d'essai à l'inscription, et fenêtre de lecture seule après
# expiration avant blocage total. Valeurs par défaut si absentes : 45 et 30.
TRIAL_DAYS=45
GRACE_DAYS=30

# --- reCAPTCHA v3 sur l'inscription (optionnel) ---
# Sans ces valeurs, la vérification anti-robot est désactivée en silence (aucune
# inscription n'est bloquée) — utilisable en dev sans compte Google. Clés gratuites
# sur https://www.google.com/recaptcha/admin (v3, domaines autorisés incluant
# "localhost" pour le développement). RECAPTCHA_SITE_KEY est publique (bundlée côté
# frontend), RECAPTCHA_SECRET_KEY ne doit jamais quitter le serveur.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Agriculture de précision : NDVI satellite (optionnel) ---
# Clé Agromonitoring (OpenWeather Agro API). Sans elle, la section NDVI affiche « non configuré ».
AGRO_API_KEY=
